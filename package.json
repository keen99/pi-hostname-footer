{
  "name": "pi-hostname-footer",
  "version": "1.0.0",
  "description": "pi extension: custom footer with hostname prefix, full token/cost/context stats, and extension status line",
  "keywords": [
    "pi-package",
    "pi-extension",
    "footer",
    "hostname"
  ],
  "license": "MIT",
  "author": "David Raistrick",
  "homepage": "https://github.com/keen99/pi-hostname-footer",
  "repository": {
    "type": "git",
    "url": "https://github.com/keen99/pi-hostname-footer.git"
  },
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npx --yes tsx@4.20.6 --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:matrix": "node test/release-matrix.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.75.4",
    "typescript": "5.9.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.75.4"
  }
}
